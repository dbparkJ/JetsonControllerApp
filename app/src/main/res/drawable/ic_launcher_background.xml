<?xml version="1.0" encoding="utf-8"?>
<!--
  GEO& launcher background.

  The gradient reproduces the approved app-icon artwork: the sky blue at the top left
  falling to the deeper GEO& blue at the bottom right. It is the only place in the
  product where this brightness of blue is used — the in-app brand colour is the
  corporate #2550A3, because a launcher icon is read once at 48dp while a UI surface is
  read for an hour in daylight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#FF18ACFD" />
                <item android:offset="0.55" android:color="#FF0A7CF8" />
                <item android:offset="1.0" android:color="#FF0059DC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
