[Unit]
Description=Jetson managed Python pipeline %i
After=network-online.target jetson-control-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/jetson-control/pipelines/%i.env
ExecStart=/opt/jetson-control/run-pipeline.py %i
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30
UMask=0027
LogsDirectory=jetson-pipelines/%i
LogsDirectoryMode=0750
# The runner and boot monitor coordinate exclusive sensor ownership through
# lock and marker files in this broker directory. ProtectSystem=strict makes
# /var read-only unless this path is explicitly delegated to the pipeline.
ReadWritePaths=-/var/lib/jetson-sensors
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
