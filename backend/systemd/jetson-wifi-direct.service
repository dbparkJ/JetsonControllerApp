[Unit]
Description=Jetson Controller Wi-Fi Direct Connection Service
After=NetworkManager.service wpa_supplicant.service jetson-control-api.service
Wants=NetworkManager.service wpa_supplicant.service jetson-control-api.service
PartOf=NetworkManager.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/jetson-control
Environment=PYTHONPATH=/opt/jetson-control
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m jetson_control.wifi_direct
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
RuntimeDirectory=jetson-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/jetson-control /var/lib/jetson-control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
