[Unit]
Description=Clean expired Jetson upload receiver staging data
RequiresMountsFor=/data/server_storage
ConditionPathIsMountPoint=/data/server_storage

[Service]
Type=oneshot
WorkingDirectory=@APP_ROOT@
EnvironmentFile=@ENV_FILE@
ExecStart=@APP_ROOT@/.venv/bin/python -m upload_receiver.admin cleanup --older-than-hours 72
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_ROOT@
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
